# Public browser variables (safe to expose)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_MAPTILER_KEY=your-maptiler-key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
VITE_SITE_URL=http://localhost:5173

# Server-only variables (never prefix with VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
MAPTILER_API_KEY=your-maptiler-key
TURNSTILE_SECRET_KEY=your-turnstile-secret
TURNSTILE_ALLOWED_HOSTNAMES=localhost,powercuts.fyi
PARTICIPANT_HMAC_SECRET=replace-with-32-plus-character-secret
PARTICIPANT_TOKEN_SECRET=replace-with-32-plus-character-secret
CRON_SECRET=replace-with-32-plus-character-secret
SITE_URL=http://localhost:5173
